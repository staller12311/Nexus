{
  "name": "frontend",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/patch-child-process.mjs ./node_modules/vite/bin/vite.js",
    "build": "tsc --noEmit && node --import ./scripts/patch-child-process.mjs ./node_modules/vite/bin/vite.js build",
    "preview": "node --import ./scripts/patch-child-process.mjs ./node_modules/vite/bin/vite.js preview",
    "test": "node --import ./scripts/patch-child-process.mjs ./node_modules/vitest/vitest.mjs run",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
