# 复制为 .env 后填入真实密钥。.env 已在 .gitignore 中，不会被提交。
# 这里的变量名必须与 config.yaml 中每个模型的 api_key_env 保持一致。

# DeepSeek
DEEPSEEK_API_KEY=

# 本地 Ollama / vLLM 等无需真实密钥，但 openai 客户端要求非空值
OLLAMA_API_KEY=ollama

# OpenAI / Moonshot / 通义千问 / 智谱 / OpenRouter 等按需添加，例如：
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPUAI_API_KEY=
# OPENROUTER_API_KEY=

# 可选：指定配置文件路径（等价于命令行 --config）
# AGENT_CONFIG=./config.yaml