# 密钥与本地配置（真实密钥只在 .env；config.yaml 含本机绝对路径与模型选择）
.env
config.yaml

# 运行时数据与日志（SQLite 主库、WAL/SHM、上传的知识库切片）
data/
workspace/
*.db
*.db-wal
*.db-shm
*.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
pytest-of-*/
.venv/
venv/
*.egg-info/
.coverage
htmlcov/

# Web（前端依赖与构建产物；npm 缓存被重定向到仓库内，避免写到沙箱外）
.npm-cache/
node_modules/
frontend/dist/
frontend/coverage/

# 编辑器 / 系统杂项
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.lnk

# 本机验证用的临时目录（假端点、自测脚本、临时配置与数据库）
_web_check/
_manual/
config.fake.yaml
tools/data/
tools/workspace/
tools/__pycache__/